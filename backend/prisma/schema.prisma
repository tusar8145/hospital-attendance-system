generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-1.1.x"]
  previewFeatures = ["jsonProtocol", "clientExtensions"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  superAdmin
  admin
  hospitalAssistant
  staff
  operator
}

/////////////////////////////
// Enum for Medical Center Type
/////////////////////////////
enum medical_center_type {
  large_hospital
  hospital
  welfare
}

/////////////////////////////
// Enum for Consultation Types
/////////////////////////////
enum ConsultationType {
  morning
  afternoon
  night
}

/////////////////////////////
// Enum for Report Status
/////////////////////////////
enum ReportStatus {
  draft
  submitted
  approved
  rejected
}

/////////////////////////////
// Enum for Approval Status
/////////////////////////////
enum ApprovalStatus {
  approved
  rejected
}

model admins {
  id                           Int         @id @default(autoincrement())
  name                         String
  role                         Role        @default(admin)
  email                        String?     @unique 
  password                     String
  address                      String?     @db.VarChar(300)
  phone                        String?     @db.VarChar(20)
  created_at                   DateTime?   @default(now()) 
  created_by                   Int?
  updated_at                   DateTime?   @default(now()) 
  updated_by                   Int? 
  photo                        String?

  // Relations for admin hierarchy
  admins                       admins[]    @relation("admin_con1")
  creator                      admins?     @relation("admin_con1", fields: [created_by], references: [id])

  // Many-to-many relation with medical centers
  medical_centers              admin_medical_center[]

  // Other relations
  services_clients_issues_client_ services_clients_issues[] @relation("issue_client_")
  services_clients_issues_creator_ services_clients_issues[] @relation("issue_creator_")
  services_clients_issues_reply_by_ services_clients_issues[] @relation("issue_reply_by_")
  services_clients_issues_reply_ services_clients_issues_reply[] @relation("issue_user_")

  // Medical centers created/updated by this admin
  created_medical_centers      medical_center[]    @relation("MedicalCenterCreatedBy")
  updated_medical_centers      medical_center[]    @relation("MedicalCenterUpdatedBy")
  
  // Departments created/updated by this admin
  created_departments          department[]        @relation("DepartmentCreatedBy")
  updated_departments          department[]        @relation("DepartmentUpdatedBy")
  
  // Doctors created/updated by this admin
  created_doctors              doctor[]            @relation("DoctorCreatedBy")
  updated_doctors              doctor[]            @relation("DoctorUpdatedBy")
  
  // Doctor departments created/updated by this admin
  created_doctor_departments   doctor_department[] @relation("DoctorDepartmentCreatedBy")
  updated_doctor_departments   doctor_department[] @relation("DoctorDepartmentUpdatedBy")
  
  // Reports relations
  created_reports              report[]            @relation("ReportCreatedBy")
  updated_reports              report[]            @relation("ReportUpdatedBy")
  approved_reports             report[]            @relation("ReportApprovedBy")
  
  // Comments relations
  report_comments              report_comment[]
  
  // Approval relations
  report_approvals             report_approval[]
}

/////////////////////////////
// MedicalCenter
/////////////////////////////
model medical_center {
  id           Int                 @id @default(autoincrement())
  name         String              @unique
  type         medical_center_type
  address      String?
  status       Int                 @default(1)
  logo         String?
  primary_color String?
  sub_color_1  String?
  sub_color_2  String?
  
  // NEW: Section names for welfare facilities
  section4_name          String?     @default("〇〇〇〇")
  section5_name          String?     @default("〇〇〇〇")
  section6_name          String?     @default("〇〇〇〇")
  section7_name          String?     @default("〇〇〇〇")
  
  // NEW: Capacity fields for welfare facilities
  section1_capacity      Int?        @default(0)
  section2_capacity      Int?        @default(0)
  section3_capacity      Int?        @default(0)
  section4_capacity      Int?        @default(0)
  section5_capacity      Int?        @default(0)
  section6_capacity      Int?        @default(0)
  section7_capacity      Int?        @default(0)
  
  doctors      doctor[]
  departments  department[]        // New relation to departments
  
  created_by   Int
  created_at   DateTime?           @default(now())
  updated_by   Int?
  updated_at   DateTime?           @default(now())

  // Many-to-many relation with admins
  admins       admin_medical_center[]

  // Reports for this medical center
  reports      report[]
  welfare_report_data welfare_report_data[] // One-to-many relation with welfare data

  // Relations
  created_admin admins? @relation("MedicalCenterCreatedBy", fields: [created_by], references: [id])
  updated_admin admins? @relation("MedicalCenterUpdatedBy", fields: [updated_by], references: [id])
}

model admin_medical_center {
  id              Int            @id @default(autoincrement())
  admin_id        Int
  medical_center_id Int
  created_at      DateTime?      @default(now())

  admin           admins         @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  medical_center  medical_center @relation(fields: [medical_center_id], references: [id], onDelete: Cascade)

  @@unique([admin_id, medical_center_id])
}

/////////////////////////////
// Department
/////////////////////////////
model department {
  id           Int        @id @default(autoincrement())
  name         String
  floor        String? 
  medical_center medical_center @relation(fields: [medical_center_id], references: [id])
  medical_center_id Int
  status       Int        @default(1)
  
  doctor_links doctor_department[]
  report_details report_detail[]
  report_details_mid        report_detail_mid[]  

  created_by   Int
  created_at   DateTime?  @default(now())
  updated_by   Int?
  updated_at   DateTime?  @default(now())

  // Relations
  created_admin admins? @relation("DepartmentCreatedBy", fields: [created_by], references: [id])
  updated_admin admins? @relation("DepartmentUpdatedBy", fields: [updated_by], references: [id])

  //@@unique([name, medical_center_id])  // Department names must be unique within a medical center
}

/////////////////////////////
// Doctor
/////////////////////////////
model doctor {
  id                 Int        @id @default(autoincrement())
  name               String
  license_no         String?
  medical_center     medical_center   @relation(fields: [medical_center_id], references: [id])
  medical_center_id  Int
  status             Int        @default(1)
  dept_links         doctor_department[]

  // OR if you want to handle uniqueness with optional license_no differently
  @@unique([name, medical_center_id, license_no], name: "doctor_identity")

  created_by   Int
  created_at   DateTime?           @default(now())
  updated_by   Int?
  updated_at   DateTime?           @default(now())

  // Report relations
  report_details_as_doctor1 report_detail[] @relation("ReportDoctor1")
  report_details_as_doctor2 report_detail[] @relation("ReportDoctor2")
  report_details_as_doctor3 report_detail[] @relation("ReportDoctor3")

  // Relations
  created_admin admins? @relation("DoctorCreatedBy", fields: [created_by], references: [id])
  updated_admin admins? @relation("DoctorUpdatedBy", fields: [updated_by], references: [id])
}

/////////////////////////////
// Doctor ↔ Department Mapping
/////////////////////////////
model doctor_department {
  id           Int        @id @default(autoincrement())
  doctor       doctor     @relation(fields: [doctor_id], references: [id])
  doctor_id    Int
  department   department @relation(fields: [department_id], references: [id])
  department_id Int
  status       Int        @default(1)

  @@unique([doctor_id, department_id])

  created_by   Int
  created_at   DateTime?           @default(now())
  updated_by   Int?
  updated_at   DateTime?           @default(now())

  // Relations
  created_admin admins? @relation("DoctorDepartmentCreatedBy", fields: [created_by], references: [id])
  updated_admin admins? @relation("DoctorDepartmentUpdatedBy", fields: [updated_by], references: [id])
}

model services_clients_issues {
  id         Int     @id @default(autoincrement())
  subject       String? 
  issue  String? @db.MediumText()
  reply  String? @db.MediumText()
  link String?
  is_delete Int?    @default(0)
  is_seen                  Int?    @default(0)
  is_solved                  Int?    @default(0)
  access_users String? 
  client_id                  Int? 
  client_   admins?  @relation ("issue_client_", fields:[client_id], references:[id]) 
  creator                      Int?
  creator_   admins?  @relation ("issue_creator_", fields:[creator], references:[id]) 
  reply_by                      Int?
  reply_by_   admins?  @relation ("issue_reply_by_", fields:[reply_by], references:[id]) 
  created                      String? @db.VarChar(40)
  replied                      String? @db.VarChar(40)
  status_date  String? @db.VarChar(40)

  issues_reply services_clients_issues_reply[] @relation("issues_reply")
}

model services_clients_issues_reply {
  id         Int     @id @default(autoincrement())
  user_id         Int
  issue_user_id         Int
  reply   String? @db.MediumText()
  link String?
  issue_id         Int
  is_seen                    Int?    @default(0)
  is_active                    Int?    @default(1)
  created                      String? @db.VarChar(40)
  modified                     String? @db.VarChar(40)
  creator                      Int?
  modifier                     Int?
  issue   services_clients_issues  @relation ("issues_reply", fields:[issue_id], references:[id])
  user_   admins?  @relation ("issue_user_", fields:[user_id], references:[id]) 
}

model password_reset_otps {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  otp       String   @db.VarChar(10)
  token     String   @db.VarChar(255) @unique
  expires_at DateTime
  used      Boolean  @default(false)
  created_at DateTime @default(now())
  
  @@index([email])
  @@index([token])
}

/////////////////////////////
// Report (Parent Table)
/////////////////////////////
model report {
  id                      Int         @id @default(autoincrement())
  report_no               String      @unique
  report_date             DateTime    @db.Date
  medical_center_id       Int
  status                  ReportStatus @default(draft)
  special_notes           String?     @db.Text
  
  // Add these fields for better tracking
  submitted_at            DateTime?
  approved_at             DateTime?
  rejected_at             DateTime?
  rejection_reason        String?     @db.Text
  
  // Stats from form
  admission_count         Int?        @default(0) // 入院数
  discharge_count         Int?        @default(0) // 退院数
  external_morning        Int?        @default(0) // 外来-午前診
  external_afternoon      Int?        @default(0) // 外来-午後診
  external_duty           Int?        @default(0) // 外来-当直
  emergency_transport     Int?        @default(0) // 緊急搬入数
  post_transport_admission Int?      @default(0) // 搬入後入院件数
  visit_count             Int?        @default(0) // 訪問
  
  // Foreign keys
  medical_center          medical_center @relation(fields: [medical_center_id], references: [id])
  
  next_role               String?     @default("operator")
  // Creator info
  created_by              Int
  created_by_admin        admins?     @relation("ReportCreatedBy", fields: [created_by], references: [id])
  created_at              DateTime?   @default(now())
  
  // Updater info
  updated_by              Int?
  updated_by_admin        admins?     @relation("ReportUpdatedBy", fields: [updated_by], references: [id])
  updated_at              DateTime?   @default(now())
  
  // Approver info
  approved_by             Int?
  approved_by_admin       admins?     @relation("ReportApprovedBy", fields: [approved_by], references: [id])
  
  hospital_type           String?

  external_consultation_details Json?   @db.Json



  // Relations
  report_details          report_detail[]  // Child records
  report_comments         report_comment[] // Comments
  shift_nurses            report_shift_nurse[] // Shift nurses
  duty_staff              report_duty_staff[] // Duty staff
  approvals               report_approval[] // Approvals
  report_details_mid        report_detail_mid[] // Mid report details
  welfare_report_data     welfare_report_data? // NEW: One-to-one relation with welfare data
  
  @@index([medical_center_id])
  @@index([report_date])
  @@index([status])
  @@index([report_no])
  @@index([next_role])

  @@unique([medical_center_id, report_date])
  @@index([medical_center_id, report_date])
  @@index([status, report_date])
}

/////////////////////////////
// Report Detail (Child Table for Big Hospital)
/////////////////////////////
model report_detail {
  id                      Int         @id @default(autoincrement())
  report_id               Int         // Parent report
  sequence_no             Int         // 通番 within report (01, 02, etc.)
  department_id           Int?        // 診療区 (内科, 外科, etc.) - NOW OPTIONAL
  floor                   String?     // Floor field with relation to department floor
  
  // Consultation types - using enum ConsultationType
  consultation_type       ConsultationType // 0: 午前診, 1: 午後診, 2: 夜診
  
  // Doctors (can have up to 3 doctors per consultation)
  doctor_id_1             Int?        // 診療担当医 1
  doctor_id_2             Int?        // 診療担当医 2
  doctor_id_3             Int?        // 診療担当医 3
  
  patient_count           Int         @default(0) // 患者数
  
  // Relations
  report                  report      @relation(fields: [report_id], references: [id], onDelete: Cascade)
  department              department? @relation(fields: [department_id], references: [id])
  doctor1                 doctor?     @relation("ReportDoctor1", fields: [doctor_id_1], references: [id])
  doctor2                 doctor?     @relation("ReportDoctor2", fields: [doctor_id_2], references: [id])
  doctor3                 doctor?     @relation("ReportDoctor3", fields: [doctor_id_3], references: [id])
  
  created_at              DateTime?   @default(now())
  updated_at              DateTime?   @default(now())
  
  @@unique([report_id, sequence_no, consultation_type])
  @@index([report_id])
  @@index([department_id])
  @@index([doctor_id_1])
  @@index([doctor_id_2])
  @@index([doctor_id_3])
}

/////////////////////////////
// Report Detail Mid (Child Table for Hospital Type 2)
/////////////////////////////
model report_detail_mid {
  id                      Int         @id @default(autoincrement())
  report_id               Int         // Parent report
  sequence_no             Int         // 通番 within report (01, 02, etc.)
  department_id           Int         // 診療区 (内科, 外科, etc.)
  
  // Consultation types - using enum ConsultationType
  consultation_type       ConsultationType // 0: 午前診, 1: 午後診, 2: 夜診
  
  // Patient counts (replaces doctors)
  total_patients          Int         @default(0) // 合計 (Total patients)
  new_patients            Int         @default(0) // 新規 (New patients)
  
  // Relations
  report                  report      @relation(fields: [report_id], references: [id], onDelete: Cascade)
  department              department  @relation(fields: [department_id], references: [id])
  
  created_at              DateTime?   @default(now())
  updated_at              DateTime?   @default(now())
  
  @@unique([report_id, sequence_no, consultation_type])
  @@index([report_id])
  @@index([department_id])
}

/////////////////////////////
// Report Comment
/////////////////////////////
model report_comment {
  id                      Int         @id @default(autoincrement())
  report_id               Int
  admin_id                Int
  comment                 String      @db.Text
  is_internal             Boolean     @default(false) // Internal note vs public comment
  can_edit                Boolean     @default(true)
  edited_at               DateTime?
  
  // Relations
  report                  report      @relation(fields: [report_id], references: [id], onDelete: Cascade)
  admin                   admins      @relation(fields: [admin_id], references: [id])
  
  created_at              DateTime?   @default(now())
  updated_at              DateTime?   @default(now())
  
  @@index([report_id])
  @@index([admin_id])
  @@index([created_at])
}

/////////////////////////////
// Report Approval Table
/////////////////////////////
model report_approval {
  id                      Int         @id @default(autoincrement())
  report_id               Int
  admin_id                Int
  approval_status         ApprovalStatus @default(approved)
  comments                String?     @db.Text
  previous_status         ReportStatus?
  bypassed_lower_roles    Boolean     @default(false)
  
  // Relations
  report                  report      @relation(fields: [report_id], references: [id], onDelete: Cascade)
  admin                   admins      @relation(fields: [admin_id], references: [id])
  
  created_at              DateTime?   @default(now())
  updated_at              DateTime?   @default(now())
  
  @@unique([report_id, admin_id])
  @@index([report_id])
  @@index([admin_id])
}

/////////////////////////////
// Shift Nurses (for 外来看護師 section)
/////////////////////////////
model report_shift_nurse {
  id                      Int         @id @default(autoincrement())
  report_id               Int
  shift_type              Int         // 0: 準夜 (early night), 1: 深夜 (late night)
  nurse_name              String      // Nurse name
  
  // Relations
  report                  report      @relation(fields: [report_id], references: [id], onDelete: Cascade)
  
  created_at              DateTime?   @default(now())
  
  @@index([report_id])
  @@index([shift_type])
}

/////////////////////////////
// Duty Staff (for 当直 section)
/////////////////////////////
model report_duty_staff {
  id                      Int         @id @default(autoincrement())
  report_id               Int
  position                String      // Position name (保安, 医事, etc.)
  staff_name_1            String?     // First staff name
  staff_name_2            String?     // Second staff name
  staff_name_3            String?     // Third staff name - NEW
  
  // Relations
  report                  report      @relation(fields: [report_id], references: [id], onDelete: Cascade)
  
  created_at              DateTime?   @default(now())
  updated_at              DateTime?   @default(now())
  
  @@unique([report_id, position])
  @@index([report_id])
}

/////////////////////////////
// Welfare Report Data (for medical_center_type = welfare)
/////////////////////////////
model welfare_report_data {
  id                      Int         @id @default(autoincrement())
  report_id               Int         @unique // Link to main report
  medical_center_id       Int
  
  // NEW FIELDS: After date and before section 1
  conference_events       String?     @db.Text    // 会議・行事等
  special_notes_section   String?     @db.Text    // 特記事項 (section specific)
  
  // Section 1: 入所 (Long-term care) - 6 writeable fields
  section1_admission_count        Int?        @default(0) // 当日入所者数
  section1_discharge_count        Int?        @default(0) // 当日退所者数
  section1_outside_hospital       Int?        @default(0) // 外泊・入院者数
  section1_admission_treated      Int?        @default(0) // 入所扱
  section1_hospitalization_count  Int?        @default(0) // 入院者数
  section1_discharge_treated      Int?        @default(0) // 退所扱
  
  // Section 2: 短期入所 (Short-term care) - 4 writeable fields (NOT 6)
  section2_admission_count        Int?        @default(0) // 当日入所者数
  section2_discharge_count        Int?        @default(0) // 当日退所者数
  section2_outside_hospital       Int?        @default(0) // 外泊・入院者数
  section2_hospitalization_count  Int?        @default(0) // 入院者数
  // Note: section2_admission_treated and section2_discharge_treated are NOT in section 2
  
  // Section 3: ケアハウス (Care house) - 4 writeable fields
  section3_admission_count        Int?        @default(0) // 当日入所者数
  section3_discharge_count        Int?        @default(0) // 当日退所者数
  section3_outside_hospital       Int?        @default(0) // 外泊・入院者数
  section3_hospitalization_count  Int?        @default(0) // 入院者数
  
  // Sections 4-7: ABCD sections (Customizable names) - 1 writeable field each
  section4_daily_users            Int?        @default(0) // 当日利用者数
  section5_daily_users            Int?        @default(0)
  section6_daily_users            Int?        @default(0)
  section7_daily_users            Int?        @default(0)
  
  // Capacity fields for each section (stored in DB)
  section1_capacity      Int?        @default(0)
  section2_capacity      Int?        @default(0)
  section3_capacity      Int?        @default(0)
  section4_capacity      Int?        @default(0)
  section5_capacity      Int?        @default(0)
  section6_capacity      Int?        @default(0)
  section7_capacity      Int?        @default(0)
  
  // NEW FIELDS: Before 管理事項 section
  vacant_bed_notes        String?     @db.Text    // 空床発生自由
  response_notes          String?     @db.Text    // 対応
  
  // Relations
  report                  report      @relation(fields: [report_id], references: [id], onDelete: Cascade)
  medical_center          medical_center @relation(fields: [medical_center_id], references: [id])
  
  created_at              DateTime?   @default(now())
  updated_at              DateTime?   @default(now())
  
  @@index([report_id])
  @@index([medical_center_id])
  @@index([created_at])
}