generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-1.1.x"]
  previewFeatures = "clientExtensions"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

 
enum Role {
superAdmin
admin
hospitalAssistant
staff
}



model admins {
  id                           Int         @id @default(autoincrement())
  name                         String
  role                         Role        @default(admin)
  email                        String?     @unique 
  password                     String
  address                      String?     @db.VarChar(300)
  phone                        String?      @db.VarChar(20)
  created_at                   DateTime? @default(now()) 
  created_by                   Int?
  updated_at                   DateTime? @default(now()) 
  updated_by                   Int? 
  hospital_id                  Int?
  photo                        String?

   hospitalCreate hospitals[] @relation("admin_con")
  hospital  hospitals? 
  admins  admins[] @relation("admin_con1")
  creator admins? @relation("admin_con1", fields: [created_by], references: [id])
  staff_hospital   hospitals?    @relation("abc", fields: [hospital_id], references: [id])

 services_clients_issues_client_ services_clients_issues[] @relation("issue_client_")
 services_clients_issues_creator_ services_clients_issues[] @relation("issue_creator_")
  services_clients_issues_reply_by_ services_clients_issues[] @relation("issue_reply_by_")
 services_clients_issues_reply_ services_clients_issues_reply[] @relation("issue_user_")

}
 

model hospitals {
  id                           Int         @id @default(autoincrement())
  logo                         String?
  name                         String     
  address                      String?   
  created_by                   Int  
  admin_id                     Int @unique          
  created_at                   DateTime? @default(now()) 
  updated_at                   DateTime? @default(now()) 
  updated_by                   Int? 

  primary_color String?
  sub_color_1 String?
  sub_color_2 String?


  creator admins? @relation("admin_con", fields: [created_by], references: [id])
  admin   admins    @relation(fields: [admin_id], references: [id])
  test test[] @relation("test")
  staff_admin admins[]   @relation("abc")
  dpc_generate dpc_generate[] @relation("hospital")
  dpc_disease_classi dpc_disease_classi[] @relation("dpc_disease_classi")
}

 

model injuries {
  id                           Int         @id @default(autoincrement())
  receipt                      Int         
  icd                          String      
  name                         String      @db.VarChar(300)
  hospital_id                  Int?
  parent_id                    Int?
  created_by                   Int            
  created_at                   DateTime? @default(now()) 
  updated_at                   DateTime? @default(now()) 
  updated_by                   Int? 

  childs injuries[] @relation("injuries")
  parents injuries? @relation("injuries", fields: [parent_id], references: [id])
}

//     score   
model medical_practices {
  id                           Int         @id @default(autoincrement())
  receipt                      Int         
  name                         String      @db.VarChar(300)
  class                        String
  score                        Int      
  hospital_id                  Int?
  parent_id                    Int?
treat_code String?

  created_by                   Int            
  created_at                   DateTime? @default(now()) 
  updated_at                   DateTime? @default(now()) 
  updated_by                   Int? 

  childs medical_practices[] @relation("medical_practices")
  parents medical_practices? @relation("medical_practices", fields: [parent_id], references: [id])
}

      
model medicines {
  id                           Int         @id @default(autoincrement())
  receipt                      Int        
  name                         String      @db.VarChar(300)
  class                        String
  unit                         String      
  price                        Int
  hospital_id                  Int?
  parent_id                    Int?

  created_by                   Int            
  created_at                   DateTime? @default(now()) 
  updated_at                   DateTime? @default(now()) 
  updated_by                   Int? 

  childs medicines[] @relation("medicines")
  parents medicines? @relation("medicines", fields: [parent_id], references: [id])

}

  
model medicinal_efficacy {
  id                           Int         @id @default(autoincrement())
  receipt                      Int         
  name                         String       
  hospital_id                  Int?
  parent_id                    Int?

  created_by                   Int            
  created_at                   DateTime? @default(now()) 
  updated_at                   DateTime? @default(now()) 
  updated_by                   Int? 

  childs medicinal_efficacy[] @relation("medicinal_efficacy")
  parents medicinal_efficacy? @relation("medicinal_efficacy", fields: [parent_id], references: [id])
}


model icd_dpc {
  id                           Int         @id @default(autoincrement())
  receipt                      Int         
  dpc                          String
  name                         String
  icd                          String
  hospital_id                  Int?
  parent_id                    Int?

  created_by                   Int            
  created_at                   DateTime? @default(now()) 
  updated_at                   DateTime? @default(now()) 
  updated_by                   Int? 


  childs icd_dpc[] @relation("icd_dpc")
 
  parents icd_dpc? @relation("icd_dpc", fields: [parent_id], references: [id])
}

